---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found · Unofficial Life in the UK">
  <section
    class="rounded-3xl border border-[var(--color-border)] bg-white px-6 py-10 shadow-[var(--shadow-card)]"
  >
    <p class="text-sm uppercase tracking-[0.25rem] text-[var(--color-brand-secondary)]">
      404
    </p>
    <h1 class="mt-4 font-[var(--font-display)] text-3xl font-semibold sm:text-4xl">
      Mind the gap.
    </h1>
    <p class="mt-4 text-lg text-[var(--color-muted-foreground)]">
      That page is on a delayed service. Please change here for the homepage.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex rounded-full bg-[var(--color-brand-primary)] px-5 py-2 text-sm font-semibold text-white transition hover:bg-[var(--color-brand-secondary)]"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
