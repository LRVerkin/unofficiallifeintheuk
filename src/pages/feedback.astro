---
import BaseLayout from "@/layouts/BaseLayout.astro";

const fallbackEmail = "feedback@unofficiallifeinthe.uk";
---

<BaseLayout title="Feedback · Unofficial Life in the UK">
  <section
    class="rounded-3xl border border-[var(--color-border)] bg-white px-6 py-10 shadow-[var(--shadow-card)]"
  >
    <h1 class="font-[var(--font-display)] text-3xl font-semibold sm:text-4xl">
      Feedback form coming soon
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-muted-foreground)]">
      The submission form (with optional email and Resend-powered relay) lands in the next
      session. In the meantime, you can email us directly.
    </p>
    <a
      href={`mailto:${fallbackEmail}`}
      class="mt-8 inline-flex rounded-full bg-[var(--color-brand-primary)] px-5 py-2 text-sm font-semibold text-white transition hover:bg-[var(--color-brand-secondary)]"
    >
      Email {fallbackEmail}
    </a>
  </section>
</BaseLayout>
