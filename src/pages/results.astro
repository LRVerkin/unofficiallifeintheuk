---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Your Results · ACTUAL Life in the UK">
  <div class="flex flex-col gap-6">
    <header class="border-l-[10px] border-[var(--color-brand-primary)] pl-6">
      <h1 class="text-3xl font-bold sm:text-4xl">Your Results</h1>
    </header>

    <div id="results-mount"></div>
  </div>

  <script>
    import { createRoot } from "react-dom/client";
    import { createElement } from "react";
    import { ResultsView } from "@/components/react/ResultsView";

    const container = document.getElementById("results-mount");
    if (container) {
      const root = createRoot(container);
      root.render(createElement(ResultsView));
    }
  </script>
</BaseLayout>
