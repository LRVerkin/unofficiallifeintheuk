---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ResultsView } from "@/components/react/ResultsView";
---

<BaseLayout title="Your Results · Unofficial Life in the UK">
  <div class="flex flex-col gap-6">
    <header>
      <p class="text-sm uppercase tracking-[0.2rem] text-[var(--color-brand-secondary)]">
        Unofficial Life in the UK
      </p>
      <h1 class="mt-2 font-[var(--font-display)] text-3xl font-semibold sm:text-4xl">
        Your Results
      </h1>
    </header>

    <ResultsView client:only="react" />
  </div>
</BaseLayout>
