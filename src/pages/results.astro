---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Your Results · Unofficial Life in the UK">
  <section
    class="rounded-3xl border border-[var(--color-border)] bg-white px-6 py-10 shadow-[var(--shadow-card)]"
  >
    <h1 class="font-[var(--font-display)] text-3xl font-semibold sm:text-4xl">
      Results page coming soon
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-muted-foreground)]">
      Personas, diplomas, and a shareable card will land here once the quiz UI ships.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex rounded-full border border-[var(--color-brand-primary)] px-5 py-2 text-sm font-semibold text-[var(--color-brand-primary)] transition hover:bg-[var(--color-brand-primary)] hover:text-white"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
