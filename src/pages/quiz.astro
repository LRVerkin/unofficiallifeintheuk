---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="ACTUAL Life in the UK · Take the test">
  <div class="flex flex-col gap-6">
    <header class="border-l-[10px] border-[var(--color-brand-primary)] pl-6">
      <h1 class="text-3xl font-bold sm:text-4xl">The Test</h1>
      <p class="mt-2 max-w-2xl text-base text-[var(--color-muted-foreground)]">
        24 questions. Answer each one — you'll see your result at the end.
      </p>
    </header>

    <div id="quiz-mount"></div>
  </div>

  <script>
    import { createRoot } from "react-dom/client";
    import { createElement } from "react";
    import { QuizApp } from "@/components/react/QuizApp";

    const container = document.getElementById("quiz-mount");
    if (container) {
      const root = createRoot(container);
      root.render(createElement(QuizApp));
    }
  </script>
</BaseLayout>
