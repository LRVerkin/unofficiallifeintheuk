---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Unofficial Life in the UK"
  description="Take the ACTUAL Life in the UK test and find out if you could become a UK citizen."
>
  <section class="flex flex-col gap-8">
    <div class="border-l-[10px] border-[var(--color-brand-primary)] pl-6">
      <h1 class="text-4xl font-bold leading-tight sm:text-5xl">
        Could you become a UK citizen?
      </h1>
      <p class="mt-4 text-xl leading-snug sm:text-2xl">
        Take the <a
          href="https://www.gov.uk/life-in-the-uk-test"
          target="_blank"
          rel="noreferrer"
          class="font-bold underline underline-offset-4 decoration-2 hover:text-[var(--color-brand-primary)]"
          >ACTUAL Life in the UK</a
        > test and find out!
      </p>
    </div>

    <div class="flex flex-col gap-4 text-base leading-relaxed sm:text-lg">
      <p>
        <em>Life in the UK</em> is an official test you must pass to gain British citizenship.
        It's famous for having nothing to do with real life in the UK — most of your British
        friends couldn't pass it without studying.
      </p>
      <p>
        Our <strong>UNOFFICIAL Life in the UK</strong> test has no 1988 Olympics, no Tower of
        London construction: only REAL classics from the REAL United Kingdom!
      </p>
    </div>

    <a
      href="/quiz"
      class="group relative block overflow-hidden border-4 border-[var(--color-foreground)] shadow-[0_4px_0_var(--color-foreground)] transition-transform hover:-translate-y-0.5 focus-visible:-translate-y-0.5"
      aria-label="Take the test"
    >
      <img
        src="/union-jack.svg"
        alt=""
        aria-hidden="true"
        class="block h-44 w-full object-cover sm:h-56"
      />
      <span
        class="absolute inset-0 flex items-center justify-center bg-[rgba(0,0,0,0.35)] text-3xl font-bold tracking-wide text-white sm:text-4xl"
      >
        TAKE THE TEST
      </span>
    </a>
  </section>
</BaseLayout>
