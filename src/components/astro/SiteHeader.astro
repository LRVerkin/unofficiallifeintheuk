---
const NAV_LINKS = [
  { href: "/quiz", label: "Take the Test" },
  { href: "/results", label: "Results" },
  { href: "/feedback", label: "Feedback" },
];
---

<header
  class="sticky top-0 z-20 border-b border-[var(--color-border)] bg-[var(--color-surface)]/85 backdrop-blur supports-[backdrop-filter]:bg-[var(--color-surface)]/85"
>
  <div
    class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8"
  >
    <a href="/" class="text-lg font-semibold tracking-tight">
      Unofficial Life in the UK
    </a>
    <nav class="hidden gap-6 text-sm font-medium sm:flex">
      {
        NAV_LINKS.map((item) => (
          <a href={item.href} class="hover:text-[var(--color-brand-primary)]">
            {item.label}
          </a>
        ))
      }
    </nav>
    <a
      href="/quiz"
      class="rounded-full border border-[var(--color-brand-primary)] px-4 py-2 text-sm font-semibold text-[var(--color-brand-primary)] transition hover:bg-[var(--color-brand-primary)] hover:text-white"
    >
      Start Quiz
    </a>
  </div>
</header>
