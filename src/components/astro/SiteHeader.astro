---
const pathname = Astro.url.pathname;
const showCta = pathname !== "/quiz" && pathname !== "/quiz/";
---

<header
  class="border-b-[10px] border-[var(--color-brand-primary)] bg-[var(--color-foreground)]"
>
  <div
    class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8"
  >
    <a
      href="/"
      class="text-lg font-bold tracking-tight text-white hover:underline sm:text-xl"
    >
      UNOFFICIAL Life in the UK
    </a>
    {
      showCta && (
        <a
          href="/quiz"
          class="inline-flex items-center justify-center bg-[var(--color-brand-accent)] px-4 py-2 text-sm font-bold text-[var(--color-foreground)] shadow-[0_2px_0_var(--color-foreground)] hover:bg-white"
        >
          Take the test
        </a>
      )
    }
  </div>
</header>
