---
interface Props {
  href?: string;
  variant?: "link" | "button";
}

const {
  href = import.meta.env.PUBLIC_KO_FI_URL ?? "https://ko-fi.com/",
  variant = "link",
} = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center text-sm font-bold transition-colors";

const variantStyles =
  variant === "button"
    ? "bg-[var(--color-brand-primary)] px-4 py-2 text-white shadow-[0_2px_0_var(--color-foreground)] hover:bg-[var(--color-brand-secondary)]"
    : "text-[var(--color-brand-primary)] underline-offset-2 hover:underline";

const label = "Support us on Ko-fi";
---

<a
  href={href}
  target="_blank"
  rel="noreferrer"
  data-ko-fi-link
  class={`${baseStyles} ${variantStyles}`}
>
  {label}
</a>
