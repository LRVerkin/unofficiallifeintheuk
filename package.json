{
  "name": "unofficial-life-in-the-uk",
  "version": "0.1.0",
  "description": "Humorous Life in the UK quiz built with Astro, React, Tailwind, and a fully-typed content pipeline.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "typecheck": "astro check && tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "echo \"Playwright suite lands in a later session\" && exit 0",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,astro}": [
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{md,mdx,json,css,scss,astro}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^5.18.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.12.2",
    "tailwindcss": "^4.2.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9",
    "eslint-plugin-astro": "^1.7.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.0.8"
  }
}
